<div class="pop" id="pop" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
  <button type="button" class="ib x" data-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
  <div class="eyebrow">{{ section.settings.eyebrow }}</div>
  <h3>{{ section.settings.heading }}</h3>
  <p>{{ section.settings.text }}</p>
  {%- form 'customer', class: 'pop-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,popup">
    <input type="email" name="contact[email]" required placeholder="Your email" aria-label="Email">
    <button class="btn btn-gold btn-block" type="submit">{{ section.settings.button }}</button>
    {%- if form.posted_successfully? -%}<p class="ok">Done. Use code {{ section.settings.code }} at checkout.</p>{%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Discount popup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the Flex List for early drops and your first-order discount." },
    { "type": "text", "id": "button", "label": "Button", "default": "Claim my 10%" },
    { "type": "text", "id": "code", "label": "Discount code to show", "default": "FLEX10" }
  ]
}
{% endschema %}
