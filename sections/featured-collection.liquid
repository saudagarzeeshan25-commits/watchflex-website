<section class="{% if section.settings.alt_bg %}alt{% endif %}" id="shop"><div class="wrap">
  <div class="eyebrow reveal">{{ section.settings.eyebrow }}</div>
  <h2 class="sec-title reveal">{{ section.settings.heading }}</h2>
  {%- if section.settings.subtext != blank -%}<p class="sec-sub reveal">{{ section.settings.subtext }}</p>{%- endif -%}

  {%- assign coll = section.settings.collection -%}
  {%- assign wrap_class = 'rail' -%}
  {%- if section.settings.layout == 'grid' -%}{%- assign wrap_class = 'grid' -%}{%- endif -%}
  <div class="{{ wrap_class }}">
    {%- if coll != blank -%}
      {%- for product in coll.products limit: section.settings.limit -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="card"><div class="img">{{ 'product-1' | placeholder_svg_tag }}</div><div class="info"><div class="br">Brand</div><h4>Example watch</h4><div class="price">$199</div></div></article>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if coll != blank and section.settings.show_all -%}
    <p style="text-align:center;margin-top:20px"><a class="btn btn-line" href="{{ coll.url }}">View all</a></p>
  {%- endif -%}
</div></section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most wanted" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Swipe. Tap. Flex." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rail", "options": [
      { "value": "rail", "label": "Swipe carousel" },
      { "value": "grid", "label": "Grid" }
    ] },
    { "type": "checkbox", "id": "alt_bg", "label": "Grey background", "default": true },
    { "type": "checkbox", "id": "show_all", "label": "Show 'View all' button", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
