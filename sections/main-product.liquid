{%- liquid
  assign current = product.selected_or_first_available_variant
  assign related_coll = product.collections | first
-%}
<div class="product-page" data-product-handle="{{ product.handle }}">
  <div class="pgal" id="pgal">
    {%- for media in product.media -%}
      <div>
        {%- if media.media_type == 'image' -%}
          {%- if forloop.first -%}
            {{ media | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100', sizes: '100vw', alt: media.alt | default: product.title }}
          {%- else -%}
            {{ media | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', sizes: '100vw', alt: media.alt | default: product.title }}
          {%- endif -%}
        {%- else -%}
          {{ media | media_tag: image_size: '1100x' }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div>{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- endfor -%}
  </div>
  <div class="dots" id="dots" aria-hidden="true">
    {%- for media in product.media -%}<i class="{% if forloop.first %}on{% endif %}"></i>{%- endfor -%}
  </div>

  <div class="pinfo">
    <div class="eyebrow">{{ product.vendor }}</div>
    <h1>{{ product.title }}</h1>

    <div class="price" id="price">
      <span data-price>{{ current.price | money_without_trailing_zeros }}</span>
      <s data-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money_without_trailing_zeros }}</s>
      <span class="save" data-save{% unless current.compare_at_price > current.price %} hidden{% endunless %}>
        Save {{ current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price }}%
      </span>
    </div>

    <div class="stock" data-stock hidden></div>

    {%- form 'product', product, id: 'product-form', data-ajax: 'true', data-product-form: 'true' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="vg">
            <label>{{ option.name }}</label>
            <div class="pills" data-option="{{ forloop.index0 }}" role="radiogroup" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                <button type="button" role="radio" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}" class="pill{% if option.selected_value == value %} on{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <p class="delivery">🚚 {{ section.settings.delivery_text }}</p>

      <button type="submit" class="btn btn-gold btn-block" id="padd" style="margin-top:16px" data-add-btn{% unless current.available %} disabled{% endunless %}>
        {%- if current.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
      <div class="buynow" style="margin-top:10px">{{ form | payment_button }}</div>
    {%- endform -%}

    {%- if settings.whatsapp_number != blank -%}
      <a class="wa" target="_blank" rel="noopener" href="https://wa.me/{{ settings.whatsapp_number | strip }}?text={{ 'Hi, I want to order ' | append: product.title | append: ' (' | append: current.price | money_without_trailing_zeros | append: ')' | url_encode }}">Order on WhatsApp</a>
    {%- endif -%}

    <script type="application/json" data-variants>
      [
        {%- for v in product.variants -%}
          {"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price | money_without_trailing_zeros | json }},"compare":{{ v.compare_at_price | money_without_trailing_zeros | json }},"onSale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %},"save":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}{% else %}0{% endif %},"available":{{ v.available | json }},"inventory":{% if v.inventory_management and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}-1{% endif %}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>

    <div class="trust">
      <div>💵 Cash on Delivery</div><div>↺ 7-day returns</div><div>🔒 Secure payments</div>
    </div>

    <div class="acc open"><button type="button" aria-expanded="true">Highlights<span>+</span></button><div class="pn">{{ product.description }}</div></div>

    <div class="acc"><button type="button" aria-expanded="false">Delivery &amp; returns<span>+</span></button><div class="pn">{{ section.settings.shipping_text }}</div></div>

    {%- if related_coll != blank -%}
      <div class="mini">
        <h3>You may also like</h3>
        <div class="rail">
          {%- for p in related_coll.products limit: 7 -%}
            {%- unless p.id == product.id -%}{% render 'product-card', card_product: p %}{%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<div class="sticky on" id="sticky">
  <div class="price" data-sticky-price>{{ current.price | money_without_trailing_zeros }}</div>
  <button type="button" class="btn btn-gold" id="sadd" data-sticky-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}Add to cart{% else %}Sold out{% endif %}</button>
</div>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "text", "id": "delivery_text", "label": "Delivery estimate", "default": "Delivery in 4–7 days across India · Cash on Delivery available" },
    { "type": "textarea", "id": "shipping_text", "label": "Delivery & returns text", "default": "Free delivery across India in 4–7 days. Pay online by UPI, card or net banking, or choose Cash on Delivery. Easy 7-day returns on unworn watches." }
  ]
}
{% endschema %}
