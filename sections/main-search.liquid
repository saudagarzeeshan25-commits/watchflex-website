{%- paginate search.results by 24 -%}
<section><div class="wrap">
  <h1 class="sec-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="searchpage">
    <input type="hidden" name="type" value="product">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search watches" aria-label="Search">
    <button class="btn btn-gold" type="submit">Search</button>
  </form>
  {%- if search.performed -%}
    <p class="sec-sub" style="margin-top:14px">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms }}&rdquo;</p>
    <div class="grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager">
        {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endif -%}
</div></section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search page" }
{% endschema %}
