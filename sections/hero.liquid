<section class="hero" aria-label="Hero">
  <div class="hero-bg"></div>
  {%- if section.settings.video == blank and section.settings.image == blank -%}
    <div class="hero-watch"><img src="{{ 'hero-watch.jpg' | asset_url }}" alt="" width="640" height="640" fetchpriority="high"></div>
  {%- endif -%}
  {%- if section.settings.video != blank -%}
    <div class="hero-media">
      {{ section.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero-video' }}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero-media">
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.heading, class: 'hero-img' }}
    </div>
  {%- endif -%}
  <div class="hero-in">
    <div class="eyebrow" style="color:var(--gold-light)">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading }}<br><em>{{ section.settings.heading_accent }}</em></h1>
    <p>{{ section.settings.text }}</p>
    <div class="row">
      {%- if section.settings.btn1_label != blank -%}<a href="{{ section.settings.btn1_link | default: routes.collections_url }}" class="btn btn-gold">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a href="{{ section.settings.btn2_link | default: routes.collections_url }}" class="btn btn-line">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video (muted loop)" },
    { "type": "image_picker", "id": "image", "label": "Poster / fallback image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Men's Watches" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Time," },
    { "type": "text", "id": "heading_accent", "label": "Heading (gold line)", "default": "worn loud." },
    { "type": "text", "id": "text", "label": "Text", "default": "Gold, rose gold and steel watches for the modern man. Delivered across India." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Shop Watches" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Why Watch Flex" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
