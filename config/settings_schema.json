  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Page background", "default": "#FFFFFF" },
      { "type": "color", "id": "color_bg_alt", "label": "Alternate section background", "default": "#F6F5F2" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#0A0A0B" },
      { "type": "color", "id": "color_gold", "label": "Gold accent", "default": "#B8893B" },
      { "type": "color", "id": "color_gold_light", "label": "Champagne gold (fills, borders, icons)", "default": "#C9A96E" },
      { "type": "color", "id": "color_gold_deep", "label": "Deep gold (gold text on white)", "default": "#8F6B22" },
      { "type": "color", "id": "color_dark", "label": "Header, footer and dark sections", "default": "#0A0A0B" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "text", "id": "heading_font_name", "label": "Heading font (Google Fonts name)", "default": "Playfair Display" },
      { "type": "text", "id": "body_font_name", "label": "Body font (Google Fonts name)", "default": "Manrope" }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo (use a version on a black background, or a transparent PNG)" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon (WF monogram)" }
    ]
  },
  {
    "name": "Cart & WhatsApp",
    "settings": [
      { "type": "text", "id": "cart_note", "label": "Cart note", "default": "Free delivery across India · Cash on Delivery available" },
      { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code, digits only)", "info": "e.g. 919876543210. Shows an 'Order on WhatsApp' button on product pages.", "default": "" }
    ]
  },
  {
    "name": "Discount popup",
    "settings": [
      { "type": "checkbox", "id": "popup_enabled", "label": "Show popup", "default": true },
      { "type": "range", "id": "popup_delay", "label": "Show after (seconds)", "min": 3, "max": 60, "step": 1, "default": 9 }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" }
